# Server
PORT=8000
NODE_ENV=development
# Set to 1 when running behind a reverse proxy (nginx, Render, Railway...)
TRUST_PROXY=0

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://kunal:password@localhost:5432/local_service_db?schema=public"

# JWT – generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=replace-me
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_SECRET=replace-me
REFRESH_TOKEN_EXPIRES=7d

# Email (Gmail app password or any SMTP provider)
SMTP_USER=you@example.com
SMTP_PASS=replace-me
